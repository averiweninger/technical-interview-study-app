# Copy into .env.local and replace placeholders. Never commit actual credentials.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_with_your_key
# Never place a Supabase secret or service-role key in NEXT_PUBLIC_ variables.

# Server-only lesson progress writes. Use a secret key for the SAME Supabase project.
SUPABASE_SECRET_KEY=sb_secret_replace_with_your_server_only_key

# Canonical application origin. Required in production; use HTTPS outside local development.
APP_URL=http://localhost:3000
